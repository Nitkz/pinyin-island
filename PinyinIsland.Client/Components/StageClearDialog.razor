@using MudBlazor

<div class="stage-clear-modal-backdrop">
    <div class="stage-clear-card bounce-modal">
        <!-- Confetti Burst Emoji Particles -->
        <div class="confetti-container">
            <span class="confetti c1">🎉</span>
            <span class="confetti c2">✨</span>
            <span class="confetti c3">⭐</span>
            <span class="confetti c4">🎊</span>
            <span class="confetti c5">🎈</span>
            <span class="confetti c6">🌟</span>
        </div>

        <!-- Header Ribbon -->
        <div class="clear-header-ribbon">
            <h2 class="clear-title">🌟 ยอดเยี่ยมมาก! 🌟</h2>
            <p class="clear-subtitle">ผ่านด่านแล้ว เก่งที่สุดเลย!</p>
        </div>

        <!-- Star Rating Display -->
        <div class="stars-display-row">
            @for (int i = 1; i <= 3; i++)
            {
                var isEarned = i <= StarsEarned;
                <div class="star-wrapper @(isEarned ? $"star-earned star-delay-{i}" : "star-empty")">
                    <span class="star-char">@(isEarned ? "⭐" : "☆")</span>
                </div>
            }
        </div>

        <!-- Score / Feedback summary badge -->
        <div class="score-summary-pill">
            <span class="summary-icon">🏆</span>
            <span class="summary-text">คะแนนเต็ม @TotalQuestions ข้อ ตอบถูกครั้งแรก @CorrectFirstTry ข้อ</span>
        </div>

        <!-- Action Buttons -->
        <div class="clear-actions-row">
            <button type="button"
                    class="tactile-action-btn btn-replay"
                    @onclick="OnReplayClicked"
                    aria-label="เล่นอีกรอบ">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="btn-icon" />
                <span>เล่นอีกรอบ</span>
            </button>

            <button type="button"
                    class="tactile-action-btn btn-next"
                    @onclick="OnNextStageClicked"
                    aria-label="ด่านต่อไป">
                <span>ด่านต่อไป</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="btn-icon" />
            </button>
        </div>
    </div>
</div>

<style>
    .stage-clear-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 24, 48, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        user-select: none;
        -webkit-user-select: none;
    }

    .stage-clear-card {
        position: relative;
        background: linear-gradient(180deg, #FFFFFF 0%, #FFFDE7 100%);
        border: 8px solid #FFD54F;
        border-radius: 40px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 
                    inset 0 4px 0 rgba(255, 255, 255, 0.9),
                    inset 0 -8px 0 #FFE082;
        width: 100%;
        max-width: 500px;
        padding: 36px 28px 30px;
        text-align: center;
        overflow: visible;
    }

    .bounce-modal {
        animation: popupBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @@keyframes popupBounce {
        0% { transform: scale(0.3) translateY(100px); opacity: 0; }
        70% { transform: scale(1.06) translateY(-10px); opacity: 1; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* Floating Confetti Particles */
    .confetti-container {
        position: absolute;
        inset: -40px;
        pointer-events: none;
        overflow: hidden;
    }

    .confetti {
        position: absolute;
        font-size: 2rem;
        animation: floatConfetti 3s ease-in-out infinite alternate;
    }

    .c1 { top: 10px; left: 20px; animation-delay: 0.1s; }
    .c2 { top: 20px; right: 30px; animation-delay: 0.4s; }
    .c3 { top: 60px; left: 40px; animation-delay: 0.7s; }
    .c4 { top: 50px; right: 40px; animation-delay: 0.3s; }
    .c5 { bottom: 30px; left: 30px; animation-delay: 0.5s; }
    .c6 { bottom: 20px; right: 20px; animation-delay: 0.8s; }

    @@keyframes floatConfetti {
        0% { transform: translateY(0) rotate(0deg) scale(0.9); }
        100% { transform: translateY(-25px) rotate(20deg) scale(1.15); }
    }

    /* Header Ribbon */
    .clear-header-ribbon {
        margin-bottom: 20px;
    }

    .clear-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #E65100;
        margin: 0;
        text-shadow: 0 2px 4px rgba(230, 81, 0, 0.2);
        letter-spacing: 0.5px;
    }

    .clear-subtitle {
        font-size: 1.25rem;
        font-weight: 700;
        color: #F57C00;
        margin-top: 6px;
    }

    /* Stars Row */
    .stars-display-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin: 24px 0;
    }

    .star-wrapper {
        font-size: 4rem;
        line-height: 1;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .star-earned {
        color: #FFB300;
        filter: drop-shadow(0 8px 12px rgba(255, 179, 0, 0.5));
        animation: starPopIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .star-empty {
        color: #CFD8DC;
        opacity: 0.6;
    }

    .star-delay-1 { animation-delay: 0.2s; }
    .star-delay-2 { animation-delay: 0.45s; }
    .star-delay-3 { animation-delay: 0.7s; }

    @@keyframes starPopIn {
        0% { transform: scale(0) rotate(-180deg); opacity: 0; }
        80% { transform: scale(1.3) rotate(15deg); opacity: 1; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* Summary pill */
    .score-summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #FFF8E1;
        border: 2px solid #FFE082;
        border-radius: 999px;
        padding: 10px 24px;
        margin-bottom: 28px;
        box-shadow: 0 4px 10px rgba(255, 179, 0, 0.15);
    }

    .summary-icon {
        font-size: 1.4rem;
    }

    .summary-text {
        font-size: 1.05rem;
        font-weight: 700;
        color: #795548;
    }

    /* Action Buttons */
    .clear-actions-row {
        display: flex;
        gap: 16px;
        justify-content: center;
    }

    .tactile-action-btn {
        flex: 1;
        min-height: 64px;
        border-radius: 24px;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 1.25rem;
        font-weight: 800;
        font-family: inherit;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
        outline: none;
        padding: 0 20px;
    }

    .tactile-action-btn:active {
        transform: translateY(4px);
    }

    .btn-replay {
        background: linear-gradient(180deg, #78909C 0%, #546E7A 100%);
        color: #ffffff;
        box-shadow: 0 6px 0 #37474F, 0 10px 20px rgba(55, 71, 79, 0.35);
    }

    .btn-replay:active {
        box-shadow: 0 2px 0 #37474F;
    }

    .btn-next {
        background: linear-gradient(180deg, #66BB6A 0%, #43A047 100%);
        color: #ffffff;
        box-shadow: 0 6px 0 #2E7D32, 0 10px 20px rgba(46, 125, 50, 0.4);
        animation: pulseNextBtn 1.8s ease-in-out infinite;
    }

    .btn-next:active {
        box-shadow: 0 2px 0 #2E7D32;
    }

    @@keyframes pulseNextBtn {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.03); }
    }

    .btn-icon {
        font-size: 1.6rem !important;
    }

    @@media (max-width: 480px) {
        .stage-clear-card {
            padding: 28px 18px 24px;
        }
        .clear-title {
            font-size: 1.8rem;
        }
        .star-wrapper {
            font-size: 3.2rem;
        }
        .tactile-action-btn {
            font-size: 1.1rem;
            min-height: 56px;
        }
    }
</style>

@code {
    [Parameter] public int StarsEarned { get; set; } = 3;
    [Parameter] public int TotalQuestions { get; set; } = 4;
    [Parameter] public int CorrectFirstTry { get; set; } = 4;
    [Parameter] public EventCallback OnReplay { get; set; }
    [Parameter] public EventCallback OnNextStage { get; set; }

    private async Task OnReplayClicked()
    {
        await OnReplay.InvokeAsync();
    }

    private async Task OnNextStageClicked()
    {
        await OnNextStage.InvokeAsync();
    }
}
