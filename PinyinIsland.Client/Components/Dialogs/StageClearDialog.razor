@using MudBlazor

<div class="stage-clear-modal-backdrop">
    <div class="stage-clear-card bounce-modal @(IsBossStage ? "boss-clear-card" : "")">
        <!-- Confetti Burst Emoji Particles -->
        <div class="confetti-container">
            <span class="confetti c1">🎉</span>
            <span class="confetti c2">✨</span>
            <span class="confetti c3">⭐</span>
            <span class="confetti c4">🎊</span>
            <span class="confetti c5">🎈</span>
            <span class="confetti c6">🌟</span>
            @if (IsBossStage)
            {
                <span class="confetti c7">🪙</span>
                <span class="confetti c8">💎</span>
                <span class="confetti c9">👑</span>
            }
        </div>

        @if (IsBossStage)
        {
            <!-- Boss Stage Victory Header -->
            <div class="boss-victory-badge-top">
                <span class="crown-emoji">👑</span>
                <span class="boss-badge-text">พิชิตบอสประจำเกาะสำเร็จ!</span>
            </div>

            <div class="clear-header-ribbon">
                <h2 class="boss-clear-title">🏆 ปลดล็อกหีบสมบัติ @IslandName 🏆</h2>
                <p class="boss-clear-subtitle">กุญแจทองคำไขขุมทรัพย์ราชาพินอินสำเร็จแล้ว!</p>
            </div>

            <!-- Boss Chest & Golden Key Visual Animation Stage -->
            <div class="boss-chest-stage">
                <!-- Sunburst Light Rays behind chest -->
                <div class="sunburst-rays @(IsChestOpen ? "sunburst-active" : "")"></div>

                <!-- Golden Key Animation (Flight and Unlock Journey) -->
                <div class="golden-key-actor @(IsChestOpen ? "key-done" : "key-animating")">
                    <div class="golden-key-svg-wrap">
                        <svg viewBox="0 0 100 100" class="svg-key">
                            <defs>
                                <radialGradient id="goldKeyGrad" cx="40%" cy="40%" r="60%">
                                    <stop offset="0%" stop-color="#FFF9C4" />
                                    <stop offset="50%" stop-color="#FFD54F" />
                                    <stop offset="100%" stop-color="#FF8F00" />
                                </radialGradient>
                                <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
                                    <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#FF6F00" flood-opacity="0.6"/>
                                </filter>
                            </defs>
                            <!-- Key bow / head -->
                            <circle cx="35" cy="35" r="22" fill="url(#goldKeyGrad)" stroke="#FF6F00" stroke-width="4" filter="url(#goldGlow)"/>
                            <circle cx="35" cy="35" r="10" fill="#FFFDE7" stroke="#FF8F00" stroke-width="2"/>
                            <!-- Key shaft -->
                            <rect x="31" y="52" width="8" height="38" rx="4" fill="url(#goldKeyGrad)" stroke="#FF6F00" stroke-width="2"/>
                            <!-- Key teeth -->
                            <rect x="39" y="72" width="14" height="6" rx="2" fill="url(#goldKeyGrad)" stroke="#FF6F00" stroke-width="2"/>
                            <rect x="39" y="82" width="10" height="6" rx="2" fill="url(#goldKeyGrad)" stroke="#FF6F00" stroke-width="2"/>
                        </svg>
                    </div>
                </div>

                <!-- Treasure Chest Graphic -->
                <div class="chest-box-container @(IsChestOpen ? "chest-open" : "chest-locked")">
                    <!-- Bouncing Coins Shower Emitters -->
                    @if (IsChestOpen)
                    {
                        <div class="coins-shower-emitter">
                            <span class="burst-coin bcoin-1">🪙</span>
                            <span class="burst-coin bcoin-2">💎</span>
                            <span class="burst-coin bcoin-3">🪙</span>
                            <span class="burst-coin bcoin-4">✨</span>
                            <span class="burst-coin bcoin-5">🪙</span>
                            <span class="burst-coin bcoin-6">💎</span>
                            <span class="burst-coin bcoin-7">⭐</span>
                            <span class="burst-coin bcoin-8">🪙</span>
                        </div>
                    }

                    <div class="chest-art-wrap">
                        <img src="@ChestImageUrl" alt="หีบสมบัติ @IslandName" class="chest-img" />
                    </div>

                    @if (!IsChestOpen)
                    {
                        <div class="giant-lock-badge @(IsKeyInserted ? "lock-unlocked" : "")">
                            <MudIcon Icon="@(IsKeyInserted ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)" Class="boss-lock-icon" />
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Standard Stage Clear Header Ribbon -->
            <div class="clear-header-ribbon">
                <h2 class="clear-title">🌟 ยอดเยี่ยมมาก! 🌟</h2>
                <p class="clear-subtitle">ผ่านด่านแล้ว เก่งที่สุดเลย!</p>
            </div>
        }

        <!-- Star Rating Display (Synchronized with Audio Chimes) -->
        <div class="stars-display-row">
            @for (int i = 1; i <= 3; i++)
            {
                var isRevealed = i <= RevealedStarsCount;
                <div class="star-wrapper @(isRevealed ? "star-earned" : "star-empty")">
                    <span class="star-char">@(isRevealed ? "⭐" : "☆")</span>
                </div>
            }
        </div>

        <!-- Cheering Panda Pirate Mascot & Speech Bubble -->
        <div class="mascot-cheer-section">
            <div class="mascot-cheer-avatar-wrap">
                <img src="assets/images/panda-pirate.jpeg" alt="น้องหมีแพนด้าโจรสลัด" class="mascot-cheer-avatar" />
                <span class="mascot-cheer-sparkle">✨</span>
            </div>
            <div class="mascot-cheer-bubble">
                @if (IsBossStage)
                {
                    <span class="bubble-text"><strong>สุดยอดมาก!</strong> ปลดล็อกสมบัติเกาะนี้สำเร็จแล้ว! 👑🪙</span>
                }
                else if (StarsEarned == 3)
                {
                    <span class="bubble-text"><strong>ยอดเยี่ยมที่สุด!</strong> กะลาสีน้อยคว้า 3 ดาวเต็ม! 🌟</span>
                }
                else if (StarsEarned == 2)
                {
                    <span class="bubble-text"><strong>เก่งมากๆ เลย!</strong> เกือบได้ 3 ดาวเต็มแล้วนะ! 🐼</span>
                }
                else
                {
                    <span class="bubble-text"><strong>เก่งมาก!</strong> ลุยด่านต่อไปหรือกดเล่นอีกรอบได้นะ! 💪</span>
                }
            </div>
        </div>

        <!-- Score / Feedback summary badge -->
        <div class="score-summary-pill">
            <span class="summary-icon">@(IsBossStage ? "👑" : "🏆")</span>
            <span class="summary-text">คะแนนเต็ม @TotalQuestions ข้อ ตอบถูกครั้งแรก @CorrectFirstTry ข้อ</span>
        </div>

        <!-- Action Buttons -->
        <div class="clear-actions-row">
            <button type="button"
                    class="tactile-action-btn btn-replay"
                    @onclick="OnReplayClicked"
                    aria-label="เล่นอีกรอบ">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="btn-icon" />
                <span>เล่นอีกรอบ</span>
            </button>

            <button type="button"
                    class="tactile-action-btn btn-next"
                    @onclick="OnNextStageClicked"
                    aria-label="ด่านต่อไป">
                <span>ด่านต่อไป</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="btn-icon" />
            </button>
        </div>
    </div>
</div>

<style>
    .stage-clear-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 24, 48, 0.75);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        user-select: none;
        -webkit-user-select: none;
    }

    .stage-clear-card {
        position: relative;
        background: linear-gradient(180deg, #FFFFFF 0%, #FFFDE7 100%);
        border: 8px solid #FFD54F;
        border-radius: 40px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 
                    inset 0 4px 0 rgba(255, 255, 255, 0.9),
                    inset 0 -8px 0 #FFE082;
        width: 100%;
        max-width: 540px;
        padding: 32px 28px 28px;
        text-align: center;
        overflow: visible;
    }

    .boss-clear-card {
        border-color: #FFA000;
        background: linear-gradient(180deg, #FFFFFF 0%, #FFF8E1 60%, #FFECB3 100%);
        box-shadow: 0 25px 60px rgba(255, 160, 0, 0.4), 
                    0 0 40px rgba(255, 215, 0, 0.3),
                    inset 0 4px 0 rgba(255, 255, 255, 0.9);
    }

    .bounce-modal {
        animation: popupBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @@keyframes popupBounce {
        0% { transform: scale(0.3) translateY(100px); opacity: 0; }
        70% { transform: scale(1.06) translateY(-10px); opacity: 1; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* Confetti */
    .confetti-container {
        position: absolute;
        inset: -40px;
        pointer-events: none;
        overflow: hidden;
    }

    .confetti {
        position: absolute;
        font-size: 2rem;
        animation: floatConfetti 3s ease-in-out infinite alternate;
    }

    .c1 { top: 10px; left: 20px; animation-delay: 0.1s; }
    .c2 { top: 20px; right: 30px; animation-delay: 0.4s; }
    .c3 { top: 60px; left: 40px; animation-delay: 0.7s; }
    .c4 { top: 50px; right: 40px; animation-delay: 0.3s; }
    .c5 { bottom: 30px; left: 30px; animation-delay: 0.5s; }
    .c6 { bottom: 20px; right: 20px; animation-delay: 0.8s; }
    .c7 { top: 35%; left: 15px; animation-delay: 0.2s; font-size: 2.2rem; }
    .c8 { top: 40%; right: 15px; animation-delay: 0.6s; font-size: 2.2rem; }
    .c9 { top: 5%; left: 45%; animation-delay: 0.5s; font-size: 2.5rem; }

    @@keyframes floatConfetti {
        0% { transform: translateY(0) rotate(0deg) scale(0.9); }
        100% { transform: translateY(-25px) rotate(20deg) scale(1.15); }
    }

    /* Boss Header Ribbon */
    .boss-victory-badge-top {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #FF6F00 0%, #E65100 100%);
        color: #FFFFFF;
        padding: 6px 18px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 1rem;
        box-shadow: 0 4px 12px rgba(230, 81, 0, 0.4);
        margin-bottom: 12px;
        animation: pulseBossBadge 2s infinite ease-in-out;
    }

    @@keyframes pulseBossBadge {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.06); }
    }

    .crown-emoji {
        font-size: 1.3rem;
    }

    .boss-clear-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #BF360C;
        margin: 0;
        text-shadow: 0 2px 4px rgba(191, 54, 12, 0.2);
    }

    .boss-clear-subtitle {
        font-size: 1.1rem;
        font-weight: 700;
        color: #E65100;
        margin-top: 4px;
    }

    /* Header Ribbon */
    .clear-header-ribbon {
        margin-bottom: 16px;
    }

    .clear-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #E65100;
        margin: 0;
        text-shadow: 0 2px 4px rgba(230, 81, 0, 0.2);
    }

    .clear-subtitle {
        font-size: 1.25rem;
        font-weight: 700;
        color: #F57C00;
        margin-top: 6px;
    }

    /* Boss Chest Stage */
    .boss-chest-stage {
        position: relative;
        width: 100%;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 10px 0;
    }

    .sunburst-rays {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 215, 0, 0.85) 0%, rgba(255, 160, 0, 0.45) 45%, transparent 70%);
        opacity: 0;
        transform: scale(0.4);
        transition: opacity 1.0s ease, transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        pointer-events: none;
    }

    .sunburst-active {
        opacity: 1;
        transform: scale(1.35);
        animation: spinSunburst 14s linear infinite;
    }

    @@keyframes spinSunburst {
        from { transform: scale(1.35) rotate(0deg); }
        to { transform: scale(1.35) rotate(360deg); }
    }

    /* Golden Key Actor (Smooth Cinematic Flight & Unlock Animation) */
    .golden-key-actor {
        position: absolute;
        z-index: 10;
        width: 74px;
        height: 74px;
        top: 50%;
        left: 50%;
        margin-top: -37px;
        margin-left: -37px;
        pointer-events: none;
        filter: drop-shadow(0 10px 20px rgba(255, 143, 0, 0.85));
        will-change: transform, opacity;
    }

    .key-animating {
        animation: keyFlightJourney 3.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .key-done {
        opacity: 0;
        transform: translate3d(0px, 15px, 0) scale(0.8) rotate(90deg);
    }

    @@keyframes keyFlightJourney {
        /* 1. Key hovers gracefully at top-right (0.0s - 0.7s) */
        0% {
            transform: translate3d(155px, -95px, 0) scale(1.4) rotate(-35deg);
            opacity: 1;
        }
        20% {
            transform: translate3d(148px, -90px, 0) scale(1.38) rotate(-30deg);
            opacity: 1;
        }
        /* 2. Key swoops down slowly and gracefully into center lock (0.7s - 2.3s) */
        65% {
            transform: translate3d(0px, 15px, 0) scale(0.9) rotate(0deg);
            opacity: 1;
        }
        /* 3. Key slowly turns 90 degrees inside keyhole to unlock (2.3s - 3.0s) */
        85% {
            transform: translate3d(0px, 15px, 0) scale(0.9) rotate(90deg);
            opacity: 1;
        }
        /* 4. Dissolves as chest pops open (3.0s - 3.6s) */
        100% {
            transform: translate3d(0px, 15px, 0) scale(0.75) rotate(90deg);
            opacity: 0;
        }
    }

    .svg-key {
        width: 100%;
        height: 100%;
    }

    /* Chest Box */
    .chest-box-container {
        position: relative;
        width: 180px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 5;
    }

    .chest-art-wrap {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        overflow: hidden;
        border: 4px solid #FFA000;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
        transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.5s ease;
    }

    .chest-open .chest-art-wrap {
        transform: scale(1.14);
        box-shadow: 0 0 40px rgba(255, 215, 0, 0.85), 0 16px 32px rgba(0,0,0,0.35);
        border-color: #FFD54F;
    }

    .chest-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .giant-lock-badge {
        position: absolute;
        bottom: 15px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FFE082 0%, #FFB300 100%);
        border: 3px solid #BF360C;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #BF360C;
        box-shadow: 0 6px 14px rgba(0,0,0,0.35);
        transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease;
    }

    .lock-unlocked {
        transform: scale(1.35) rotate(25deg);
        background: #C8E6C9;
        color: #2E7D32;
        border-color: #2E7D32;
    }

    .boss-lock-icon {
        font-size: 1.9rem !important;
    }

    /* Coin Shower Burst (Extended and Slower Physics) */
    .coins-shower-emitter {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 8;
    }

    .burst-coin {
        position: absolute;
        font-size: 2.3rem;
        top: 40%;
        left: 45%;
        opacity: 0;
        animation: coinBurst 3.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .bcoin-1 { --tx: -95px; --ty: -130px; animation-delay: 0.10s; }
    .bcoin-2 { --tx: 95px; --ty: -140px; animation-delay: 0.22s; }
    .bcoin-3 { --tx: -140px; --ty: -70px; animation-delay: 0.35s; }
    .bcoin-4 { --tx: 140px; --ty: -60px; animation-delay: 0.45s; }
    .bcoin-5 { --tx: -60px; --ty: -170px; animation-delay: 0.55s; }
    .bcoin-6 { --tx: 60px; --ty: -165px; animation-delay: 0.65s; }
    .bcoin-7 { --tx: 0px; --ty: -180px; animation-delay: 0.78s; }
    .bcoin-8 { --tx: -155px; --ty: -110px; animation-delay: 0.88s; }

    @@keyframes coinBurst {
        0% { transform: translate(0, 0) scale(0.3); opacity: 0; }
        22% { opacity: 1; transform: translate(var(--tx), var(--ty)) scale(1.4); }
        65% { opacity: 1; transform: translate(var(--tx), calc(var(--ty) + 30px)) scale(1.18); }
        100% { opacity: 0.8; transform: translate(var(--tx), calc(var(--ty) + 75px)) scale(1); }
    }

    /* Stars Row */
    .stars-display-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin: 18px 0;
    }

    .star-wrapper {
        font-size: 3.8rem;
        line-height: 1;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .star-earned {
        color: #FFB300;
        filter: drop-shadow(0 8px 12px rgba(255, 179, 0, 0.6));
        animation: starPopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .star-empty {
        color: #CFD8DC;
        opacity: 0.5;
    }

    @@keyframes starPopIn {
        0% { transform: scale(0.2) rotate(-90deg); opacity: 0; }
        75% { transform: scale(1.35) rotate(12deg); opacity: 1; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* Summary pill */
    /* Cheering Panda Pirate Mascot Showcase */
    .mascot-cheer-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: 12px auto 16px;
        max-width: 440px;
        padding: 4px 8px;
    }

    .mascot-cheer-avatar-wrap {
        position: relative;
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        border-radius: 50%;
        border: 4px solid #FFCA28;
        box-shadow: 0 8px 18px rgba(255, 179, 0, 0.35), inset 0 2px 0 rgba(255, 255, 255, 0.8);
        background: #FFF9C4;
        animation: mascotCheerBob 2.2s ease-in-out infinite;
    }

    .mascot-cheer-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .mascot-cheer-sparkle {
        position: absolute;
        top: -6px;
        right: -6px;
        font-size: 1.3rem;
        animation: sparkleSpin 2s linear infinite;
    }

    .mascot-cheer-bubble {
        position: relative;
        background: #FFFFFF;
        border: 3px solid #FFD54F;
        border-radius: 20px;
        padding: 10px 16px;
        text-align: left;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        font-size: 0.98rem;
        color: #E65100;
        line-height: 1.35;
    }

    .mascot-cheer-bubble::before {
        content: '';
        position: absolute;
        left: -10px;
        top: 50%;
        transform: translateY(-50%);
        border-width: 7px 10px 7px 0;
        border-style: solid;
        border-color: transparent #FFD54F transparent transparent;
    }

    .mascot-cheer-bubble::after {
        content: '';
        position: absolute;
        left: -6px;
        top: 50%;
        transform: translateY(-50%);
        border-width: 5px 8px 5px 0;
        border-style: solid;
        border-color: transparent #FFFFFF transparent transparent;
    }

    @@keyframes mascotCheerBob {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-6px) rotate(4deg); }
    }

    @@keyframes sparkleSpin {
        0% { transform: rotate(0deg) scale(0.9); }
        50% { transform: rotate(180deg) scale(1.2); }
        100% { transform: rotate(360deg) scale(0.9); }
    }

    .score-summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #FFF8E1;
        border: 2px solid #FFE082;
        border-radius: 999px;
        padding: 8px 22px;
        margin-bottom: 24px;
        box-shadow: 0 4px 10px rgba(255, 179, 0, 0.15);
    }

    .summary-icon {
        font-size: 1.4rem;
    }

    .summary-text {
        font-size: 1.05rem;
        font-weight: 700;
        color: #795548;
    }

    /* Action Buttons */
    .clear-actions-row {
        display: flex;
        gap: 16px;
        justify-content: center;
    }

    .tactile-action-btn {
        flex: 1;
        min-height: 60px;
        border-radius: 24px;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 1.25rem;
        font-weight: 800;
        font-family: inherit;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
        outline: none;
        padding: 0 20px;
    }

    .tactile-action-btn:active {
        transform: translateY(4px);
    }

    .btn-replay {
        background: linear-gradient(180deg, #78909C 0%, #546E7A 100%);
        color: #ffffff;
        box-shadow: 0 6px 0 #37474F, 0 10px 20px rgba(55, 71, 79, 0.35);
    }

    .btn-replay:active {
        box-shadow: 0 2px 0 #37474F;
    }

    .btn-next {
        background: linear-gradient(180deg, #66BB6A 0%, #43A047 100%);
        color: #ffffff;
        box-shadow: 0 6px 0 #2E7D32, 0 10px 20px rgba(46, 125, 50, 0.4);
        animation: pulseNextBtn 1.8s ease-in-out infinite;
    }

