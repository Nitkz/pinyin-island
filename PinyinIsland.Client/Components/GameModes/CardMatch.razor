<div class="mode-match-container">
    <div class="mode-header-badge">
        <span class="mode-badge-icon">🃏</span>
        <span class="mode-badge-title">เปิดการ์ดจับคู่สระและเสียง (@MatchedPairsCount/@TotalRequiredPairs คู่)</span>
    </div>

    <div class="card-match-grid">
        @foreach (var card in Cards)
        {
            var c = card;
            <div class="match-card-wrapper @(c.IsFlipped ? "flipped" : "") @(c.IsMatched ? "matched" : "")"
                 @onclick="() => TapCard(c)"
                 role="button"
                 tabindex="0">
                
                <div class="match-card-3d">
                    <!-- Card Back (Covered) -->
                    <div class="card-face card-face-back">
                        <img src="assets/images/card-back.jpeg" alt="การ์ดปริศนา" class="card-back-img" />
                    </div>

                    <!-- Card Front (Revealed) -->
                    <div class="card-face card-face-front @(c.CardType == "char" ? "face-char" : "face-sound")">
                        @if (c.CardType == "char")
                        {
                            <span class="match-pinyin-text">@c.DisplayText</span>
                            <span class="card-sub-hint">พินอิน</span>
                        }
                        else
                        {
                            <span class="match-sound-icon">🔊</span>
                            <span class="match-sound-text">@c.DisplayText</span>
                            <span class="card-sub-hint">เสียงอ่าน</span>
                        }

                        @if (c.IsMatched)
                        {
                            <div class="match-success-badge">⭐</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .mode-match-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 880px;
    }

    .mode-header-badge {
        background: rgba(255, 255, 255, 0.94);
        border: 3px solid #93C5FD;
        border-radius: 9999px;
        padding: 8px 26px;
        box-shadow: 0 8px 20px rgba(0, 100, 200, 0.15);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .mode-badge-icon { font-size: 1.4rem; }
    .mode-badge-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #1E40AF;
    }

    .card-match-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 18px;
        width: 100%;
        padding: 10px;
    }

    .match-card-wrapper {
        perspective: 1000px;
        height: 170px;
        cursor: pointer;
    }

    .match-card-3d {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        transform-style: preserve-3d;
    }

    .match-card-wrapper.flipped .match-card-3d,
    .match-card-wrapper.matched .match-card-3d {
        transform: rotateY(180deg);
    }

    .card-face {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 60, 120, 0.25);
    }

    .card-face-back {
        background: #0284C7;
        border: 4px solid #38BDF8;
    }

    .card-back-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-face-front {
        transform: rotateY(180deg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 5px solid #CBD5E1;
        background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    }

    .face-char {
        border-color: #C084FC;
        background: linear-gradient(180deg, #FAF5FF 0%, #F3E8FF 100%);
    }

    .face-sound {
        border-color: #FCD34D;
        background: linear-gradient(180deg, #FFFBEB 0%, #FEF3C7 100%);
    }

    .match-pinyin-text {
        font-size: 3.2rem;
        font-weight: 900;
        color: #7E22CE;
    }

    .match-sound-icon {
        font-size: 2.2rem;
        margin-bottom: 2px;
    }

    .match-sound-text {
        font-size: 1.7rem;
        font-weight: 800;
        color: #D97706;
    }

    .card-sub-hint {
        font-size: 0.85rem;
        font-weight: 800;
        color: #94A3B8;
        margin-top: 4px;
    }

    .match-card-wrapper.matched {
        opacity: 0.65;
        pointer-events: none;
    }

    .match-success-badge {
        position: absolute;
        top: 6px;
        right: 8px;
        font-size: 1.4rem;
        animation: starPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes starPop {
        0% { transform: scale(0); }
        100% { transform: scale(1); }
    }

    @@media (max-width: 768px) {
        .card-match-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
