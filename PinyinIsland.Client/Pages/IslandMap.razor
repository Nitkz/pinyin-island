@code {
    private UserProgress _progress = new();
    private List<IslandInfo> _islands = new();
    private IslandInfo? _selectedIsland;
    private bool _isMuted = false;
    private bool _isBackpackOpen = false;
    private int _unlockedTreasureCount = 0;

    protected override async Task OnInitializedAsync()
    {
        _islands = ProgressService.GetAllIslands();
        await LoadProgressData();
    }

    private async Task LoadProgressData()
    {
        _progress = await ProgressService.GetProgressAsync();
        var unlockedSet = await ProgressService.GetUnlockedTreasureLettersAsync(_progress);
        var allTreasure = await ProgressService.GetAllTreasureItemsAsync();
        _unlockedTreasureCount = allTreasure.Count(t => unlockedSet.Contains(t.Letter) || unlockedSet.Contains(t.DisplayLetter));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Play Map BGM automatically (looping with kid-friendly volume)
                await JS.InvokeVoidAsync("gameAudio.playBgm", "assets/audio/bgm-map.mp3", 0.4);
                await JS.InvokeVoidAsync("gameAudio.setBgmMuted", _isMuted);
            }
            catch
            {
                // Ignored if runtime not ready yet
            }
        }
    }

    private async Task GoBackHome()
    {
        try
        {
            await JS.InvokeVoidAsync("gameAudio.pauseBgm");
        }
        catch { }
        Nav.NavigateTo("/");
    }

    private int CalculateIslandStars(IslandInfo island)
    {
        return island.Stages.Sum(s => _progress.GetStageStars(s.StageId));
    }

    private void SelectIsland(IslandInfo island)
    {
        if (!_progress.IsIslandUnlocked(island.Id))
        {
            Snackbar.Add($"เกาะนี้ยังไม่ปลดล็อก! สะสมดาวจากเกาะก่อนหน้าเพื่อเปิดทาง ✨", Severity.Warning, config =>
            {
                config.VisibleStateDuration = 2500;
                config.ShowCloseIcon = false;
            });
            return;
        }

        _selectedIsland = island;
    }

    private void CloseStageDrawer()
    {
        _selectedIsland = null;
    }

    private async Task LaunchStage(int stageId)
    {
        try
        {
            await JS.InvokeVoidAsync("gameAudio.pauseBgm");
        }
        catch { }
        Nav.NavigateTo($"/play/{stageId}");
    }

    private async Task OpenBackpack()
    {
        try
        {
            await JS.InvokeVoidAsync("gameAudio.playSfx", "backpackOpen");
        }
        catch { }
        _isBackpackOpen = true;
    }

    private void CloseBackpack()
    {
        _isBackpackOpen = false;
    }

    private async Task RefreshProgress()
    {
        await LoadProgressData();
        StateHasChanged();
    }

    private async Task ToggleSound()
    {
        _isMuted = !_isMuted;
        try
        {
            await JS.InvokeVoidAsync("gameAudio.setBgmMuted", _isMuted);
        }
        catch
        {
            // Silently ignore
        }

        var message = _isMuted ? "ปิดเสียงเรียบร้อย 🔇" : "เปิดเสียงแล้ว! 🎵";
        Snackbar.Add(message, Severity.Info, config =>
        {
            config.VisibleStateDuration = 1800;
            config.ShowCloseIcon = false;
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("gameAudio.pauseBgm");
        }
        catch
        {
            // Ignore on unmount if JS runtime is disconnected
        }
    }
}


